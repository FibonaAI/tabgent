{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.2",
  "minimum_chrome_version": "142",
  "default_locale": "en",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "nativeMessaging",
    "sidePanel",
    "webNavigation",
    "debugger",
    "contextMenus",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ui/chat.html"
  },
  "action": {
    "default_title": "__MSG_toggleAgent__",
    "default_icon": {
      "16": "icons/app-16.png",
      "32": "icons/app-32.png"
    }
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none';"
  },
  "icons": {
    "16": "icons/app-16.png",
    "32": "icons/app-32.png",
    "48": "icons/app-48.png",
    "128": "icons/app-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["selection-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdf/viewer.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
